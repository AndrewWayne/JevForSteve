{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "esModuleInterop": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "src/core/**/*.ts"]
}
